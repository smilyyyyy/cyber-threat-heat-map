    {
      "id": 8,
      "type": "geomap",
      "title": "Cyber Threat Heat Map - Malicious IPs by Country",
      "description": "Each country is coloured and sized by how many malicious IPs (AbuseIPDB, OTX, CIRCL) are located there (log scale, so smaller sources stay visible). Hover for exact counts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "threatdb"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 16,
        "h": 15
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "threatdb"
          },
          "rawSql": "SELECT country_code, count(*) AS attacks,\n       round(ln(1 + count(*))::numeric, 2) AS intensity\nFROM v_ip_master\nWHERE country_code IS NOT NULL AND COALESCE(country_code,'??') IN ($country)\nGROUP BY country_code\nORDER BY attacks DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "view": {
          "id": "coords",
          "lat": 25,
          "lon": 10,
          "zoom": 1.6
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showScale": false
        },
        "tooltip": {
          "mode": "details"
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OpenStreetMap",
          "config": {}
        },
        "layers": [
          {
            "type": "heatmap",
            "name": "Attack density",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "country_code",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "config": {
              "blur": 22,
              "radius": 16,
              "weight": {
                "field": "intensity",
                "fixed": 1,
                "min": 0,
                "max": 1
              }
            }
          },
          {
            "type": "markers",
            "name": "Malicious IPs",
            "tooltip": true,
            "location": {
              "mode": "lookup",
              "lookup": "country_code",
              "gazetteer": "public/gazetteer/countries.json"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "field": "intensity",
                  "fixed": 5,
                  "min": 3,
                  "max": 22
                },
                "color": {
                  "field": "intensity"
                },
                "opacity": 0.6,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                },
                "text": {
                  "mode": "field",
                  "field": "country_code",
                  "fixed": ""
                },
                "textConfig": {
                  "fontSize": 9,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            }
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-YlRd"
          }
        },
        "overrides": []
      }
    },

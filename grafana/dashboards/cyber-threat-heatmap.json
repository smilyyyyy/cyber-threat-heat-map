    {
      "id": 11,
      "type": "table",
      "title": "Most Malicious IPs - ranked by risk score",
      "description": "Risk score (0-100) = 35% AbuseIPDB confidence + 25% report volume + 20% threat-intel sightings + 20% Shodan exposure.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "threatdb"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "threatdb"
          },
          "rawSql": "SELECT ip AS \"IP address\", COALESCE(country_code,'??') AS \"Country\",\n       risk_score AS \"Risk score\", risk_level AS \"Risk level\",\n       abuse_confidence AS \"Abuse conf. %\", total_reports AS \"Reports\",\n       intel_sightings AS \"Intel sightings\", open_ports AS \"Open ports\", cve_count AS \"CVEs\",\n       isp AS \"ISP\", usage_type AS \"Usage type\", sources AS \"Seen in\"\nFROM v_ip_risk_level\nWHERE COALESCE(country_code,'??') IN ($country)\nORDER BY risk_score DESC, total_reports DESC\nLIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Risk score",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Risk score"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic",
                  "valueDisplayMode": "text"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "custom.width",
                "value": 170
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 25
                    },
                    {
                      "color": "orange",
                      "value": 50
                    },
                    {
                      "color": "dark-red",
                      "value": 75
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Risk level"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Critical": {
                        "color": "dark-red",
                        "index": 0
                      },
                      "High": {
                        "color": "orange",
                        "index": 1
                      },
                      "Medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "Low": {
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "IP address"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in AbuseIPDB",
                    "url": "https://www.abuseipdb.com/check/${__value.text}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }

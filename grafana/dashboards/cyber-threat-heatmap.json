          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ok": {
                        "color": "green",
                        "index": 0
                      },
                      "skipped": {
                        "color": "blue",
                        "index": 1
                      },
                      "rate_limited": {
                        "color": "orange",
                        "index": 2
                      },
                      "error": {
                        "color": "red",
                        "index": 3
                      },
                      "running": {
                        "color": "purple",
                        "index": 4
                      }
                    }

      "title": "Top 15 Malware Families (OTX + CIRCL)",
      "description": "Number of threat reports mentioning each malware family, split by source.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "threatdb"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "threatdb"
          },
          "rawSql": "SELECT family,\n       count(*) FILTER (WHERE source = 'OTX')   AS \"OTX\",\n       count(*) FILTER (WHERE source = 'CIRCL') AS \"CIRCL\"\nFROM v_malware\nGROUP BY family\nORDER BY count(*) DESC\nLIMIT 15",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"

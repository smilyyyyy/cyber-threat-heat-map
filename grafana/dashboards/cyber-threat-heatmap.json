          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "threatdb"
          },
          "rawSql": "SELECT started_at AS \"Started\", source AS \"Source\", status AS \"Status\",\n       rows_fetched AS \"Rows\", duration_s AS \"Seconds\", message AS \"Details\"\nFROM collection_runs\nORDER BY id DESC\nLIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
